    "clean": "cp dist/es.1bf6871a3930156c.svg dist/es.1bf6871a3930156c.svgX && cp dist/es.838804b972d82b01.svg dist/es.838804b972d82b01.svgX && cp dist/us.817d241614dff6d8.svg dist/us.817d241614dff6d8.svgX && cp dist/us.8802c010a1c68b93.svg dist/us.8802c010a1c68b93.svgX && rm -rf dist/*.svg && mv dist/us.8802c010a1c68b93.svgX dist/us.8802c010a1c68b93.svg && mv dist/us.817d241614dff6d8.svgX dist/us.817d241614dff6d8.svg && mv dist/es.1bf6871a3930156c.svgX dist/es.1bf6871a3930156c.svg && mv dist/es.838804b972d82b01.svgX dist/es.838804b972d82b01.svg",
